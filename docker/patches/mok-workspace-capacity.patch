new file mode 100644
index 0000000..fe78bd2
--- /dev/null
+++ b/tests/test_workspace_capacity.py
@@ -0,0 +1,40 @@
+import pytest
+import torch
+import torch.distributed as dist
+
+from mok import functional
+
+from .utils import generate_topk_experts, run_all_gather_top_experts_reference
+
+
+def test_variable_length_workspace(context):
+    rank, ep_size, device = context
+    config = functional.MoKConfig(max_local_tokens=1024)
+    args = dict(device=device, hidden_size=256, topk=1)
+    group = dist.group.WORLD
+    small = functional.get_workspace(config, group, num_local_tokens=512, **args)
+    large = functional.get_workspace(config, group, num_local_tokens=1024, **args)
+
+    assert small.x_buffer.shape == (512, 256)
+    assert large.x_buffer.shape == (1024, 256)
+    assert small.schedule_capacity * 2 == large.schedule_capacity
+    for name in ("x_buffer", "combine_buffer", "d_y_buffer", "d_x_routed_buffer",
+                 "router_weight_buffer", "d_router_weight_buffer",
+                 "all_gather_top_experts_buffer", "barrier_buffer", "barrier_target"):
+        assert getattr(small, name).data_ptr() == getattr(large, name).data_ptr()
+
+    # The largest call fills storage past the short call's active prefix. Each
+    # rank writes different routes so an incorrect peer stride is observable.
+    for workspace in (large, small, large, small):
+        n = workspace.num_local_tokens
+        routes = generate_topk_experts(rank, device, 2 * ep_size, 1, n).int()
+        expected = run_all_gather_top_experts_reference(routes)
+        schedule = functional.build_schedule(workspace, config, routes, num_local_experts=2)
+        torch.testing.assert_close(workspace.all_gather_top_experts_buffer, expected)
+        counts = torch.bincount(expected.flatten().long(), minlength=2 * ep_size)
+        local_counts = counts[2 * rank : 2 * rank + 2]
+        padded_counts = ((local_counts + 255) // 256) * 256
+        torch.testing.assert_close(schedule.tokens_per_expert, padded_counts.int())
+
+    with pytest.raises(ValueError, match="max_local_tokens"):
+        functional.get_workspace(config, group, num_local_tokens=1280, **args)
