diff --git a/Makefile b/Makefile
index 58bebae..1c8eb2a 100644
--- a/Makefile
+++ b/Makefile
@@ -29,12 +29,18 @@ NVCCFLAGS += -ltorch_python -ltorch_cuda -ltorch_cpu -ltorch -lc10_cuda -lc10
 NVCCFLAGS += -shared -fPIC
 NVCCFLAGS += -diag-suppress 3189 # for warnings generated by PyTorch C++ headers

-ifeq ($(ARCH),SM103)
+ifeq ($(ARCH),ALL)
+# MoK uses the BF16/MXFP8 features shared by SM100 and SM103.
+NVCCFLAGS += --threads=2
+NVCCFLAGS += -DKITTENS_SM100
+NVCCFLAGS += -gencode arch=compute_100a,code=sm_100a
+NVCCFLAGS += -gencode arch=compute_103a,code=sm_103a
+else ifeq ($(ARCH),SM103)
 NVCCFLAGS += -DKITTENS_SM103 -gencode arch=compute_103a,code=sm_103a
 else ifeq ($(ARCH),SM100)
 NVCCFLAGS += -DKITTENS_SM100 -gencode arch=compute_100a,code=sm_100a
 else
-$(error Unsupported ARCH '$(ARCH)'; expected SM100 or SM103)
+$(error Unsupported ARCH '$(ARCH)'; expected ALL, SM100 or SM103)
 endif

 all: $(OUT)
