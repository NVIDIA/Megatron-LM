# Cluster-specific settings for inference-bench. Copy to inference-bench/cluster.env (git-ignored), fill in,
# and source it before submitting:
#   source inference-bench/cluster.env
#   sbatch inference-bench/server/launch_minf.sh

# slurm options, read by sbatch from the environment.
export SBATCH_ACCOUNT=<account>
export SBATCH_PARTITION=<partition>
export SBATCH_QOS=<qos>

# Container mounts (pyxis --container-mounts) and images.
export INFERENCE_BENCH_MOUNTS=<host_path>:<container_path>
# ${VAR:-...}: launch_minf.sh re-sources this file inside the job, so an image set on the run.sh
# line (INFERENCE_BENCH_SERVE_IMAGE=...) must survive it.
export INFERENCE_BENCH_SERVE_IMAGE=${INFERENCE_BENCH_SERVE_IMAGE:-<path/to/mcore-inference.sqsh>}   # server/launch_minf.sh
export INFERENCE_BENCH_VLLM_IMAGE=<path/to/vllm-openai.sqsh>       # server/launch_vllm.sh
export INFERENCE_BENCH_CONVERT_IMAGE=<path/to/nemo.sqsh>            # convert/ (Megatron Bridge)

# Hugging Face cache: tokenizers for Super v3, HF checkpoints for conversion and the vLLM models.
export HF_HOME=<path/to/hf_home>
export INFERENCE_BENCH_FI_AUTOTUNE_DIR=<path/to/shared/dir>   # optional: vLLM FlashInfer autotune cache, reused across jobs

# Megatron (mcore) checkpoints served by server/launch_minf.sh.
export NANOV3P5_CHECKPOINT=<path/to/nano-3.5-mcore>
export NANOV3P5_TOKENIZER=<path/to/nano-3.5-hf-tokenizer>
export SUPERV3_PRETRAINED_CHECKPOINT=<path/to/superv3-pretrained-checkpoint>
export SUPERV3_CHECKPOINT=<path/to/superv3-mcore>

# Output of convert/convert_ultra_tp8ep8.sh; server/launch_minf.sh MODEL=ultrav3 serves it unless
# ULTRAV3_CHECKPOINT points elsewhere.
export ULTRA_MCORE_OUT=<path/to/nemotron-3-ultra-mcore-output>
# export ULTRAV3_CHECKPOINT=<path/to/nemotron-3-ultra-mcore>
