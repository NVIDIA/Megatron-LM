# Super v3, narrow EP: one EP8 group on 2 nodes, simulating an NVL8 domain: non-expert TP4 x DP2,
# experts EP8 (64 experts per GPU). Narrow-EP groups are independent, so one group at 1/8 of the
# wide config's concurrency gives the same per-GPU throughput and per-user speed as 8 groups on
# 64 GPUs.
MODEL=superv3
NODES=2
TP=4
EP=8
BUFFER_GB=50
MAMBA_RATIO=0.4
CUDA_GRAPH_MAX_TOKENS=2048
COMBINE_PRECISION=bf16
# Math prompts are short and distinct, so prefix caching saves nothing; it is off for the math runs.
PREFIX_CACHING=0
QOS=short
TIME=2:00:00

# Steady-state client: total concurrency levels (8 GPUs; x8 = the wide config's 64-GPU levels) of
# closed-loop math-blend load, natural EOS with no output cap; 60 s warmup + 300 s window per level.
BENCH="8 16 32 64 128 256"
