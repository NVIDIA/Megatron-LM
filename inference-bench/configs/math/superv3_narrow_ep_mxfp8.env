# Super v3, narrow EP, MXFP8 weights: superv3_narrow_ep.env with the weights quantized to MXFP8 at
# load (MInf: TRT-LLM routed MXFP8 MoE kernel; FRAMEWORK=vllm: --quantization mxfp8). One EP8
# group on 2 nodes: non-expert TP4 x DP2, experts EP8 (64 experts per GPU).
MODEL=superv3
NODES=2
TP=4
EP=8
BUFFER_GB=50
MAMBA_RATIO=0.4
CUDA_GRAPH_MAX_TOKENS=2048
COMBINE_PRECISION=bf16
# Math prompts are short and distinct, so prefix caching saves nothing; it is off for the math runs.
PREFIX_CACHING=0
QOS=short
TIME=2:00:00
FP8_RECIPE=mxfp8
# With MXFP8, overlapping the shared experts on a side stream stalls the first CUDA graph warmup
# step (GPUs pinned at 100%, no progress); run them in order until that is understood.
SHARED_EXPERT_OVERLAP=0

# Steady-state client: total concurrency levels (8 GPUs; x8 = the wide config's 64-GPU levels) of
# closed-loop math-blend load, natural EOS with no output cap; 60 s warmup + 300 s window per level.
BENCH="8 16 32 64 128 256"
