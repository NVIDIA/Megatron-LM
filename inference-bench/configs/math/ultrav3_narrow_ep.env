# Ultra v3, narrow EP: one TP8 x EP8 replica on 2 nodes (64 experts per GPU), simulating an NVL8
# domain. Narrow-EP replicas are independent, so one replica at 1/8 of the wide config's
# concurrency gives the same per-GPU throughput and per-user speed as 8 replicas on 64 GPUs.
# ~137 GB of weights per GPU (routed experts alone 131 GB at EP8), hence the small buffer.
MODEL=ultrav3
NODES=2
TP=8
EP=8
BUFFER_GB=25
MAMBA_RATIO=0.4
# The default 2048-token CUDA graphs (decode graphs captured for both MoE row bounds) run out of
# memory next to the weights and buffers; use the server's 512.
CUDA_GRAPH_MAX_TOKENS=512
COMBINE_PRECISION=bf16
# Math prompts are short and distinct, so prefix caching saves nothing; it is off for the math runs.
PREFIX_CACHING=0
QOS=short
TIME=2:00:00

# Steady-state client: total concurrency levels (8 GPUs; x8 = the wide config's 64-GPU levels) of
# closed-loop math-blend load, natural EOS with no output cap; 60 s warmup + 300 s window per level.
BENCH="8 16 32 64 128"
