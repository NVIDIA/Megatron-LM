# Ultra v3, wide EP on 64 GPUs: non-expert TP8 x DP8, experts EP64 (8 experts per GPU).
# Uses the full NVL72 domain for expert parallelism.
# 8 experts per GPU leave room for a larger KV/state buffer than narrow EP.
MODEL=ultrav3
NODES=16
TP=8
BUFFER_GB=80
MAMBA_RATIO=0.4
# CUDA-graphed prefill / mixed forwards pad their MoE work in proportion to the largest graph
# (rows bounded by graph tokens x EP, so 64x at wide EP); cap graphs at 512 tokens so larger
# prefill steps run eagerly with the exact token count.
CUDA_GRAPH_MAX_TOKENS=512
COMBINE_PRECISION=bf16
# Math prompts are short and distinct, so prefix caching saves nothing; it is off for the math runs.
PREFIX_CACHING=0
QOS=short
TIME=2:00:00

# Steady-state client: total concurrency levels (64 GPUs) of closed-loop math-blend load, natural
# EOS with no output cap; 60 s warmup + 300 s window per level.
BENCH="64 128 256 512 1024"
