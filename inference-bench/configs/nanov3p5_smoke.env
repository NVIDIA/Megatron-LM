# nano-3.5 smoke test: one node, TP4 x EP4, short decode at two concurrencies. Pick the
# dispatcher on the command line (DISPATCHER=nvls | nvl_a2a). DeepEP needs an MoE hidden size
# that is a multiple of 256, which nano-3.5 (2688, no latent) is not.
MODEL=nanov3p5
CLIENT=smoke
NODES=1
COMBINE_PRECISION=bf16
TIME=0:45:00

BENCH="1 8"
BENCH_OSL=256
BENCH_ITERS=1
BENCH_WARMUP=1
