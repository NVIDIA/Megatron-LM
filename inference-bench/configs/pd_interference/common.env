# Shared by the pd_interference configs: Super v3, math blend, steady-state client.
# BENCH is the total concurrency the client keeps in flight against the job, as in configs/math:
# 1-32 requests per decode GPU. Narrow runs one 8-GPU EP8 replica, so its levels are 1/8 of wide's
# 64-GPU levels (8..256 vs 64..2048) at the same requests per GPU.
# Each level: 120 s warmup + 2 x 300 s windows; 6 levels ~ 72 min, inside short QoS's 2 h.
MODEL=superv3
BUFFER_GB=50
MAMBA_RATIO=0.4
COMBINE_PRECISION=bf16
QOS=short
TIME=2:00:00
# Streamed replies give TTFT and decode-only TPOT per request; 16-token chunks after the first
# keep the client's SSE parsing light at 1024 users.
STEADY_STREAM=1
STEADY_STREAM_INTERVAL=16
STEADY_WARMUP=120
STEADY_WINDOW=300
STEADY_WINDOWS=2
STEADY_SAMPLE_INTERVAL=30
