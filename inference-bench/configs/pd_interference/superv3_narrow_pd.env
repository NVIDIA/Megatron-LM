# Narrow EP, disaggregated: the decode pool is superv3_narrow_agg's replica; one prefill node
# (TP4, EP4) prefills and hands KV + Mamba state to it over NIXL.
source inference-bench/configs/pd_interference/common.env
NODES=2
TP=4
EP=8
CUDA_GRAPH_MAX_TOKENS=2048
BENCH="8 16 32 64 128 256"
PD=1
PREFILL_NODES=1
PREFILL_TP=4
PREFILL_EP=4
PREFILL_CUDA_GRAPH_MAX_TOKENS=2048
