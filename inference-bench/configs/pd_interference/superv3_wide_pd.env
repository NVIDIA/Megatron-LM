# Wide EP, disaggregated: the decode pool is superv3_wide_agg's 16 nodes; one prefill node
# (TP4, EP4) prefills and hands KV + Mamba state to it over NIXL.
source inference-bench/configs/pd_interference/common.env
NODES=16
TP=4
CUDA_GRAPH_MAX_TOKENS=512
BENCH="64 128 256 512 1024 2048"
PD=1
PREFILL_NODES=1
PREFILL_TP=4
PREFILL_EP=4
PREFILL_CUDA_GRAPH_MAX_TOKENS=2048
