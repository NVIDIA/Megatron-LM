# superv3_wide_agg of configs/pd_interference (same nodes, parallelism, concurrency levels, windows),
# on WildChat-1M first user turns instead of the math blend, with the vLLM fused-MoE backend.
source inference-bench/configs/pd_interference/superv3_wide_agg.env
STEADY_DATASET=wildchat
GEMM_BACKEND=vllm
# Same prefix-cache setting as the PD runs (the KV hand-off requires KV prefix caching, and decode
# must not have a Mamba prefix cache), so disaggregation is the only difference.
PREFIX_CACHING=1
MAMBA_PREFIX_GB=0
