digraph schedule {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.35",
    nodesep="0.35",
    ranksep="0.55",
    splines=ortho,
    fontname="Helvetica",
    labelloc="t",
    label="M-FSDP v2 + PP2/VPP2 interleaved 1F1B + MoE EP overlap\nWorld=8, TP=1, PP=2, VPP=2, EP=2, dense DP=4, expert DP=2, MBS=1, GBS=16 => M=4"
  ];
  node [shape=plain, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=9, color="#64748b"];

  topology [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#475569">
      <TR><TD COLSPAN="7" BGCOLOR="#e2e8f0"><B>Logical virtual-pipeline path for each microbatch</B></TD></TR>
      <TR>
        <TD BGCOLOR="#dbeafe"><B>VS0 = P0/C0</B><BR/>layers 0-3</TD>
        <TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#dcfce7"><B>VS1 = P1/C0</B><BR/>layers 4-7</TD>
        <TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#dbeafe"><B>VS2 = P0/C1</B><BR/>layers 8-11</TD>
        <TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#dcfce7"><B>VS3 = P1/C1</B><BR/>layers 12-15</TD>
      </TR>
      <TR><TD COLSPAN="7" BGCOLOR="#fff7ed">Backward traverses VS3 &#8594; VS2 &#8594; VS1 &#8594; VS0. Physically, a microbatch visits P0 &#8594; P1 &#8594; P0 &#8594; P1.</TD></TR>
    </TABLE>
  >];

  lookup [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#475569">
      <TR><TD COLSPAN="9" BGCOLOR="#e2e8f0"><B>VPP lookup table (microbatch group size defaults to PP = 2)</B></TD></TR>
      <TR><TD BGCOLOR="#f8fafc"><B>virtual id</B></TD><TD>0</TD><TD>1</TD><TD>2</TD><TD>3</TD><TD>4</TD><TD>5</TD><TD>6</TD><TD>7</TD></TR>
      <TR><TD BGCOLOR="#f8fafc"><B>microbatch</B></TD><TD>m0</TD><TD>m1</TD><TD>m0</TD><TD>m1</TD><TD>m2</TD><TD>m3</TD><TD>m2</TD><TD>m3</TD></TR>
      <TR><TD BGCOLOR="#dbeafe"><B>forward chunk</B></TD><TD>C0</TD><TD>C0</TD><TD>C1</TD><TD>C1</TD><TD>C0</TD><TD>C0</TD><TD>C1</TD><TD>C1</TD></TR>
      <TR><TD BGCOLOR="#ffedd5"><B>backward chunk</B></TD><TD>C1</TD><TD>C1</TD><TD>C0</TD><TD>C0</TD><TD>C1</TD><TD>C1</TD><TD>C0</TD><TD>C0</TD></TR>
    </TABLE>
  >];

  p0 [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD COLSPAN="13" BGCOLOR="#bfdbfe"><B>Physical PP rank P0: local scheduler order</B></TD></TR>
      <TR>
        <TD COLSPAN="5" BGCOLOR="#f1f5f9"><B>warmup: 5 F</B></TD>
        <TD COLSPAN="3" BGCOLOR="#ede9fe"><B>steady: 3 combined 1F1B</B></TD>
        <TD COLSPAN="5" BGCOLOR="#f1f5f9"><B>cooldown: 5 B</B></TD>
      </TR>
      <TR>
        <TD BGCOLOR="#dbeafe">F m0/C0</TD><TD BGCOLOR="#dbeafe">F m1/C0</TD><TD BGCOLOR="#dbeafe">F m0/C1</TD><TD BGCOLOR="#dbeafe">F m1/C1</TD><TD BGCOLOR="#dbeafe">F m2/C0</TD>
        <TD BGCOLOR="#ede9fe">F m3/C0<BR/><B>+</B> B m0/C1</TD><TD BGCOLOR="#ede9fe">F m2/C1<BR/><B>+</B> B m1/C1</TD><TD BGCOLOR="#ede9fe">F m3/C1<BR/><B>+</B> B m0/C0</TD>
        <TD BGCOLOR="#ffedd5">B m1/C0</TD><TD BGCOLOR="#ffedd5">B m2/C1</TD><TD BGCOLOR="#ffedd5">B m3/C1</TD><TD BGCOLOR="#ffedd5">B m2/C0</TD><TD BGCOLOR="#ffedd5">B m3/C0</TD>
      </TR>
    </TABLE>
  >];

  p1 [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD COLSPAN="11" BGCOLOR="#bbf7d0"><B>Physical PP rank P1: local scheduler order</B></TD></TR>
      <TR>
        <TD COLSPAN="3" BGCOLOR="#f1f5f9"><B>warmup: 3 F</B></TD>
        <TD COLSPAN="5" BGCOLOR="#ede9fe"><B>steady: 5 combined 1F1B</B></TD>
        <TD COLSPAN="3" BGCOLOR="#f1f5f9"><B>cooldown: 3 B</B></TD>
      </TR>
      <TR>
        <TD BGCOLOR="#dbeafe">F m0/C0</TD><TD BGCOLOR="#dbeafe">F m1/C0</TD><TD BGCOLOR="#dbeafe">F m0/C1</TD>
        <TD BGCOLOR="#ede9fe">F m1/C1<BR/><B>+</B> B m0/C1</TD><TD BGCOLOR="#ede9fe">F m2/C0<BR/><B>+</B> B m1/C1</TD><TD BGCOLOR="#ede9fe">F m3/C0<BR/><B>+</B> B m0/C0</TD><TD BGCOLOR="#ede9fe">F m2/C1<BR/><B>+</B> B m1/C0</TD><TD BGCOLOR="#ede9fe">F m3/C1<BR/><B>+</B> B m2/C1</TD>
        <TD BGCOLOR="#ffedd5">B m3/C1</TD><TD BGCOLOR="#ffedd5">B m2/C0</TD><TD BGCOLOR="#ffedd5">B m3/C0</TD>
      </TR>
    </TABLE>
  >];

  caveat [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b45309">
      <TR><TD BGCOLOR="#fff7ed"><B>Reading the two rows:</B> each row is exact local scheduler-call order. Columns in P0 and P1 are not a shared, cycle-accurate clock; pipeline dependencies and P2P communication determine their physical alignment.</TD></TR>
    </TABLE>
  >];

  chunk [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#475569">
      <TR><TD COLSPAN="7" BGCOLOR="#ddd6fe"><B>Inside one purple combined step: model-chunk schedule (four layers per chunk)</B></TD></TR>
      <TR>
        <TD BGCOLOR="#f8fafc">preprocess F<BR/>postprocess B</TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#ede9fe">F layer 0<BR/><B>+</B> B layer 3</TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#ede9fe">F layer 1<BR/><B>+</B> B layer 2</TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#ede9fe">F layer 2 + B layer 1<BR/>&#8594; F layer 3 + B layer 0<BR/>&#8594; PP send/recv + delayed first-layer wgrad</TD>
      </TR>
    </TABLE>
  >];

  streams [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#475569">
      <TR><TD COLSPAN="5" BGCOLOR="#e2e8f0"><B>Inside one forward-layer + backward-layer pair</B></TD></TR>
      <TR><TD BGCOLOR="#f8fafc"><B>stream</B></TD><TD BGCOLOR="#f8fafc"><B>phase A</B></TD><TD BGCOLOR="#f8fafc"><B>phase B</B></TD><TD BGCOLOR="#f8fafc"><B>phase C</B></TD><TD BGCOLOR="#f8fafc"><B>phase D</B></TD></TR>
      <TR><TD BGCOLOR="#fef3c7"><B>EP comm</B></TD><TD>combine B</TD><TD>dispatch F</TD><TD>dispatch B</TD><TD>combine F</TD></TR>
      <TR><TD BGCOLOR="#dbeafe"><B>compute</B></TD><TD>pre-dispatch F</TD><TD>MLP B</TD><TD>MLP B wgrad &#8594; MLP F</TD><TD>pre-dispatch B</TD></TR>
      <TR><TD COLSPAN="5" BGCOLOR="#f8fafc">The two rows execute on separate CUDA streams; event dependencies preserve dataflow while EP all-to-all overlaps compute.</TD></TR>
    </TABLE>
  >];

  fsdp [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#475569">
      <TR><TD COLSPAN="7" BGCOLOR="#ccfbf1"><B>M-FSDP v2 lifecycle around each scheduled layer</B></TD></TR>
      <TR>
        <TD BGCOLOR="#ecfeff">fine-grained pre-hook<BR/><B>all-gather / unshard</B></TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#dbeafe">forward slots</TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#ecfeff">last-forward-node hook<BR/><B>reshard</B></TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#f8fafc">activation retained for B</TD>
      </TR>
      <TR>
        <TD BGCOLOR="#ecfeff">fine-grained pre-B hook<BR/><B>all-gather / unshard</B></TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#ffedd5">backward slots + delayed wgrad</TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#ecfeff">last-backward-op hook<BR/><B>reshard + reduce-scatter grad</B></TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#f8fafc">root post_backward<BR/>drain/finalize</TD>
      </TR>
      <TR><TD COLSPAN="7" BGCOLOR="#f0fdfa">Dense groups shard over DP=4; expert groups shard over expert-DP=2. Main gradients are accumulated in FP32 by this recipe.</TD></TR>
    </TABLE>
  >];

  note [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#475569">
      <TR><TD BGCOLOR="#f8fafc">This command enables <B>MoE expert-parallel communication overlap</B> and delayed wgrad. It does <B>not</B> pass <FONT FACE="monospace">--overlap-p2p-comm</FONT>, so do not interpret the diagram as enabling Megatron's optional asynchronous PP-P2P mode.</TD></TR>
    </TABLE>
  >];

  topology -> lookup -> p0 -> p1 -> caveat -> chunk -> streams -> fsdp -> note [style=invis, weight=10];
}
