digraph pp3_vpp2_example {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.35",
    nodesep="0.35",
    ranksep="0.55",
    splines=ortho,
    fontname="Helvetica",
    labelloc="t",
    label="One example: PP3 + VPP2 + M-FSDP v2 + combined 1F1B"
  ];
  node [shape=plain, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=9, color="#64748b"];

  config [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#475569">
      <TR><TD COLSPAN="6" BGCOLOR="#e2e8f0"><B>Illustrative configuration</B></TD></TR>
      <TR>
        <TD><B>World</B><BR/>12</TD>
        <TD><B>TP / PP / VPP</B><BR/>1 / 3 / 2</TD>
        <TD><B>EP / CP / ETP</B><BR/>2 / 1 / 1</TD>
        <TD><B>Dense DP / expert DP</B><BR/>4 / 2</TD>
        <TD><B>MBS / GBS</B><BR/>1 / 24 &#8658; M=6</TD>
        <TD><B>Layers</B><BR/>24 &#8658; 4 per VP chunk</TD>
      </TR>
      <TR><TD COLSPAN="6" BGCOLOR="#f8fafc">The schedule shown for one pipeline lane is repeated by its dense-DP and expert-DP peers.</TD></TR>
    </TABLE>
  >];

  topology [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#475569">
      <TR><TD COLSPAN="11" BGCOLOR="#bbf7d0"><B>Logical virtual-pipeline path for every microbatch</B></TD></TR>
      <TR>
        <TD BGCOLOR="#dbeafe"><B>VS0=P0/C0</B><BR/>L0-3</TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#dcfce7"><B>VS1=P1/C0</B><BR/>L4-7</TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#fef3c7"><B>VS2=P2/C0</B><BR/>L8-11</TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#dbeafe"><B>VS3=P0/C1</B><BR/>L12-15</TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#dcfce7"><B>VS4=P1/C1</B><BR/>L16-19</TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#fef3c7"><B>VS5=P2/C1</B><BR/>L20-23</TD>
      </TR>
      <TR><TD COLSPAN="11" BGCOLOR="#f0fdf4">Forward physically visits P0 &#8594; P1 &#8594; P2 &#8594; P0 &#8594; P1 &#8594; P2. Backward traverses the reverse path.</TD></TR>
    </TABLE>
  >];

  lookup [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD COLSPAN="13" BGCOLOR="#e2e8f0"><B>VPP lookup: M=6, two chunks, microbatch group size defaults to PP=3</B></TD></TR>
      <TR><TD BGCOLOR="#f8fafc"><B>virtual id</B></TD><TD>0</TD><TD>1</TD><TD>2</TD><TD>3</TD><TD>4</TD><TD>5</TD><TD>6</TD><TD>7</TD><TD>8</TD><TD>9</TD><TD>10</TD><TD>11</TD></TR>
      <TR><TD BGCOLOR="#f8fafc"><B>microbatch</B></TD><TD>m0</TD><TD>m1</TD><TD>m2</TD><TD>m0</TD><TD>m1</TD><TD>m2</TD><TD>m3</TD><TD>m4</TD><TD>m5</TD><TD>m3</TD><TD>m4</TD><TD>m5</TD></TR>
      <TR><TD BGCOLOR="#dbeafe"><B>forward chunk</B></TD><TD>C0</TD><TD>C0</TD><TD>C0</TD><TD>C1</TD><TD>C1</TD><TD>C1</TD><TD>C0</TD><TD>C0</TD><TD>C0</TD><TD>C1</TD><TD>C1</TD><TD>C1</TD></TR>
      <TR><TD BGCOLOR="#ffedd5"><B>backward chunk</B></TD><TD>C1</TD><TD>C1</TD><TD>C1</TD><TD>C0</TD><TD>C0</TD><TD>C0</TD><TD>C1</TD><TD>C1</TD><TD>C1</TD><TD>C0</TD><TD>C0</TD><TD>C0</TD></TR>
    </TABLE>
  >];

  schedules [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#475569">
      <TR><TD COLSPAN="4" BGCOLOR="#e2e8f0"><B>Exact local scheduler order with one extra EP-overlap warmup forward</B></TD></TR>
      <TR><TD BGCOLOR="#f8fafc"><B>rank</B></TD><TD BGCOLOR="#dbeafe"><B>warmup</B></TD><TD BGCOLOR="#ede9fe"><B>steady combined F+B</B></TD><TD BGCOLOR="#ffedd5"><B>cooldown</B></TD></TR>
      <TR>
        <TD BGCOLOR="#bfdbfe"><B>P0</B><BR/>8 / 4 / 8</TD>
        <TD ALIGN="LEFT">F m0/C0 · F m1/C0 · F m2/C0 · F m0/C1<BR/>F m1/C1 · F m2/C1 · F m3/C0 · F m4/C0</TD>
        <TD ALIGN="LEFT">F m5/C0 + B m0/C1 <FONT COLOR="#475569">(different chunks)</FONT><BR/><B>F m3/C1 + B m1/C1</B> <FONT COLOR="#b45309">(same chunk)</FONT><BR/>F m4/C1 + B m2/C1 · F m5/C1 + B m0/C0</TD>
        <TD ALIGN="LEFT">B m1/C0 · B m2/C0 · B m3/C1 · B m4/C1<BR/>B m5/C1 · B m3/C0 · B m4/C0 · B m5/C0</TD>
      </TR>
      <TR>
        <TD BGCOLOR="#bbf7d0"><B>P1</B><BR/>6 / 6 / 6</TD>
        <TD ALIGN="LEFT">F m0/C0 · F m1/C0 · F m2/C0<BR/>F m0/C1 · F m1/C1 · F m2/C1</TD>
        <TD ALIGN="LEFT">F m3/C0+B m0/C1 · F m4/C0+B m1/C1 · F m5/C0+B m2/C1<BR/>F m3/C1+B m0/C0 · F m4/C1+B m1/C0 · F m5/C1+B m2/C0</TD>
        <TD ALIGN="LEFT">B m3/C1 · B m4/C1 · B m5/C1<BR/>B m3/C0 · B m4/C0 · B m5/C0</TD>
      </TR>
      <TR>
        <TD BGCOLOR="#fde68a"><B>P2</B><BR/>4 / 8 / 4</TD>
        <TD ALIGN="LEFT">F m0/C0 · F m1/C0<BR/>F m2/C0 · F m0/C1</TD>
        <TD ALIGN="LEFT">F m1/C1+B m0/C1 · F m2/C1+B m1/C1<BR/>F m3/C0+B m2/C1 · F m4/C0+B m0/C0 · F m5/C0+B m1/C0<BR/>F m3/C1+B m2/C0 · F m4/C1+B m3/C1 · F m5/C1+B m4/C1</TD>
        <TD ALIGN="LEFT">B m5/C1 · B m3/C0<BR/>B m4/C0 · B m5/C0</TD>
      </TR>
      <TR><TD COLSPAN="4" BGCOLOR="#fff7ed">Each row is exact local call order, not a shared wall-clock timeline. P2P dependencies determine when ranks can actually advance.</TD></TR>
    </TABLE>
  >];

  focus [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#7c3aed">
      <TR><TD COLSPAN="7" BGCOLOR="#ddd6fe"><B>Focus on P0's same-chunk steady step: forward m3/C1 + backward m1/C1</B></TD></TR>
      <TR>
        <TD BGCOLOR="#ede9fe">F L12<BR/><B>+</B> B L15</TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#ede9fe">F L13<BR/><B>+</B> B L14</TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#ede9fe">F L14<BR/><B>+</B> B L13</TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#ede9fe">F L15 + B L12<BR/>&#8594; P2P + delayed first-layer wgrad</TD>
      </TR>
      <TR><TD COLSPAN="7" BGCOLOR="#f5f3ff">This is a normal forward for a new microbatch while an older microbatch runs backward through the same model chunk.</TD></TR>
    </TABLE>
  >];

  fsdp [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#475569">
      <TR><TD COLSPAN="9" BGCOLOR="#ccfbf1"><B>M-FSDP v2 work nested inside the focused combined step</B></TD></TR>
      <TR>
        <TD BGCOLOR="#ecfeff">fine-grained pre-F<BR/><B>unshard / all-gather</B></TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#dbeafe">forward submodules<BR/>+ EP dispatch/combine</TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#fee2e2"><B>safe forward release?</B></TD>
        <TD BORDER="0">&#160;</TD>
        <TD BGCOLOR="#ecfeff">fine-grained pre-B<BR/><B>unshard / all-gather</B></TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#ffedd5">backward dgrad</TD>
      </TR>
      <TR>
        <TD BGCOLOR="#f8fafc">dense group: DP4<BR/>expert group: expert-DP2</TD><TD BORDER="0">&#160;</TD>
        <TD BGCOLOR="#fef3c7">separate compute and<BR/>EP communication streams</TD><TD BORDER="0">&#160;</TD>
        <TD BGCOLOR="#fee2e2"><B>which consumer is last?</B></TD>
        <TD BORDER="0">&#160;</TD>
        <TD BGCOLOR="#fef3c7">delayed wgrad</TD><TD BORDER="0">&#8594;</TD>
        <TD BGCOLOR="#ecfeff">reshard + reduce grad<BR/>then root finalize</TD>
      </TR>
    </TABLE>
  >];

  problems [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b45309">
      <TR><TD COLSPAN="5" BGCOLOR="#ffedd5"><B>What this one example says the design must solve</B></TD></TR>
      <TR>
        <TD BGCOLOR="#fff7ed"><B>Schedule identity</B><BR/>rank, virtual id,<BR/>microbatch, chunk</TD>
        <TD BGCOLOR="#fff7ed"><B>Parameter lifetime</B><BR/>gather before use;<BR/>release after all streams</TD>
        <TD BGCOLOR="#fff7ed"><B>Gradient correctness</B><BR/>wait for delayed wgrad;<BR/>reduce exactly once</TD>
        <TD BGCOLOR="#fff7ed"><B>Collective order</B><BR/>DP4 and expert-DP2<BR/>peers stay aligned</TD>
        <TD BGCOLOR="#fff7ed"><B>Performance</B><BR/>less exposed comm;<BR/>bounded peak memory</TD>
      </TR>
    </TABLE>
  >];

  goals [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#166534">
      <TR><TD COLSPAN="5" BGCOLOR="#dcfce7"><B>Goals</B></TD></TR>
      <TR>
        <TD><B>Exact and inspectable schedule</B></TD>
        <TD><B>Multi-step numerical parity</B></TD>
        <TD><B>No premature release or reduction</B></TD>
        <TD><B>Measured throughput gain</B></TD>
        <TD><B>Predictable memory high-water mark</B></TD>
      </TR>
    </TABLE>
  >];

  config -> topology -> lookup -> schedules -> focus -> fsdp -> problems -> goals [style=invis, weight=10];
}
